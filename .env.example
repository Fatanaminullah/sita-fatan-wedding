# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# Project: sita-fatan-wedding-invitation (personal account)
# Ref: elzewxhtkqqfdjrvpahv
NEXT_PUBLIC_SUPABASE_URL=https://elzewxhtkqqfdjrvpahv.supabase.co

# Publishable / anon key. Safe to expose to the browser: RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely.
# SERVER ONLY. Never import this into a client component, never prefix it
# with NEXT_PUBLIC_, never log it. Used by the import script and the
# unauthenticated /rsvp/[token] route.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets (import script only) ---
# Source guest sheet, read once at cut-over.
GUEST_SHEET_ID=19D8PoBf0bHCIY9TGm2NrIJJc-8nmXpwgFNEGwUQNelk
# Service-account JSON, base64-encoded, or a path to the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=

