# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
#
# THIS FILE DOCUMENTS THE **STAGING** PROJECT. That is deliberate.
#
# Until 2026-08-16 this file hardcoded the PRODUCTION ref as the default, so a
# fresh `cp .env.example .env.local` pointed local dev straight at the live
# database. Every `npm run dev` then read and wrote ~336 real guests' RSVPs,
# collected by hand over weeks and, at the time, backed up nowhere.
#
#   Production ref: elzewxhtkqqfdjrvpahv
#   ^ NEVER put this in .env.local. It is here to be recognised and avoided.
#     Production is reached only by a deployed Vercel environment.
#
# Local dev points at the STAGING cloud project (decided 2026-08-16). Values
# below come from the staging project's dashboard.
#
# Note: local and staging share ONE database. A destructive local test wipes
# staging too, so avoid one during a check-in rehearsal. `supabase start` is
# still there if a genuinely disposable sandbox is needed; it is not the
# default.

# Staging project URL, https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, format sb_publishable_...
# Safe to expose to the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, format sb_secret_...
# Bypasses RLS entirely. SERVER ONLY. Never import into a client component,
# never prefix with NEXT_PUBLIC_, never log it. Used only by the import script
# and the unauthenticated /rsvp/[token] route.
SUPABASE_SECRET_KEY=

# Session pooler connection string, from Dashboard -> Connect -> Session
# pooler. Port 5432, NOT the transaction pooler on 6543: pg_dump needs a
# session. Used by psql/pg_dump only; the app never reads it.
SUPABASE_DB_URL=

# Personal access token, format sbp_...
# CLI ONLY. Used by `npx supabase ...` (db push, migration list, link) to talk
# to the Supabase management API. It is an ACCOUNT-level credential, wider than
# any project key: it can reach production regardless of what is set above, so
# always check `supabase/.temp/project-ref` before running a write command.
# Never import it into app code, never prefix it with NEXT_PUBLIC_.
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# NOTE: the legacy `anon` and `service_role` JWT keys are DEPRECATED.
# Do not use them, and do not reintroduce NEXT_PUBLIC_SUPABASE_ANON_KEY or
# SUPABASE_SERVICE_ROLE_KEY anywhere in this repo.

# --- Public site URL ---
# Only used to build absolute URLs for the link preview (og:image,
# twitter:image) via `metadataBase` in src/app/layout.tsx. A relative og:image
# is silently dropped by WhatsApp and iMessage, so the rich link degrades to a
# bare text row.
#
# Leave it unset locally: Next substitutes the real host in dev, so previews
# resolve to http://localhost:3000 on their own. Set it in the Vercel dashboard
# only if the deployed host is NOT https://sitafatan.wedding, which is the
# fallback hardcoded in layout.tsx. A preview deployment that leaves this unset
# will advertise the production domain's image, not its own.
NEXT_PUBLIC_SITE_URL=

# --- Import script ---
# scripts/import-sheet.ts takes local .xlsx file paths as CLI arguments
# (npx tsx scripts/import-sheet.ts [--force] <file1.xlsx> [file2.xlsx ...]).
# No env vars needed for it beyond the Supabase ones above.

# --- WhatsApp (Phase 2+) ---
# fake | fonnte | meta | waha
WA_PROVIDER=fake
WA_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
#
# Setup completed 2026-08-23. Full context lives in the vault:
# FATAN.HQ/Personal/Wedding/Digital Invitation/WhatsApp Broadcast - Cloud API Setup.md
#
# Non-secret identifiers, safe to keep here as defaults.
WA_PHONE_NUMBER_ID=1344518555405220
WA_WABA_ID=1552065343333774
WA_APP_ID=1247164010868571

# System User token. SERVER ONLY, never NEXT_PUBLIC_, never committed, never
# logged. Sends every template and every free-form reply.
WA_ACCESS_TOKEN=

# App secret, from App Settings -> Basic. The webhook verifies
# X-Hub-Signature-256 against this. The endpoint is public, so an empty value
# here means every forged payload would verify: src/domain/whatsapp.ts refuses
# to validate anything at all when it is blank.
WA_APP_SECRET=

# A string we invent, entered in both places: here, and in the Meta dashboard
# under Webhooks -> Verify token. Meta echoes it back once, during the GET
# handshake that activates the callback URL.
WA_VERIFY_TOKEN=

# Gate on the webhook's database write path.
#
# The webhook is unauthenticated (Meta calls it with no session), so it writes
# through two SECURITY DEFINER functions rather than through
# SUPABASE_SECRET_KEY, whose four sanctioned callers stay at four. Those
# functions are granted to `anon`, so this secret is what stops anyone holding
# the publishable key from injecting inbox rows. It must equal the single row
# in private.wa_webhook_secret; the migration creates that table empty and the
# functions fail closed until it is populated out of band.
WA_WEBHOOK_DB_SECRET=
